[Unit]
Description=career-platform (Next.js) on 127.0.0.1:3000
Documentation=https://github.com/mikejohn9542/career-platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/career-platform
# Holds DATABASE_URL, DATABASE_CA_CERT_PATH, NODE_ENV and PORT.
# Root-owned, chmod 600: it is the only place the database password exists on this host.
EnvironmentFile=/etc/career-platform.env
# --hostname pins the listener to loopback. `next start` defaults to 0.0.0.0 and ignores the
# HOSTNAME environment variable (that is standalone-mode only), so without this flag the app
# listens on every interface and is reachable from inside the VPC. The security group already
# blocks 3000 from the internet; this closes it at the process as well.
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1
# Railway gave this for free via restartPolicyType=ON_FAILURE. On EC2 nothing restarts the app
# unless it is declared here, and section 10's reboot test is what catches a missing unit.
# `always` rather than `on-failure`: a clean exit(0) from the server is still an outage, and
# on-failure would leave the box up with nothing listening.
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Sandboxing. The app runs as `ubuntu`, which is in the sudo group, so code execution in the
# Next.js process would otherwise mean root on the box. These directives do not fix that - a
# dedicated service account is the real fix and is owed before any cutover - but they remove the
# cheapest escalation routes and stop the process writing outside /opt and its own private /tmp.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
# /usr and /etc read-only; /opt stays writable so .next/cache works.
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
